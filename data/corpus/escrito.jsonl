{"id": "c01", "conversa": "A", "seq": 1, "lingua": "kea", "texto": "Kre dos katxupa", "esperado": {"accao": "pedir_clarificacao", "motivo": "variante_omitida", "produto": "cachupa", "qtd": 2}}
{"id": "c02", "conversa": "A", "seq": 2, "lingua": "kea", "texto": "Grandi. Afinal é três", "esperado": {"accao": "actualizar", "produto": "cachupa", "variante": "grande", "qtd": 3}}
{"id": "c03", "conversa": "A", "seq": 3, "lingua": "kea", "texto": "manda pa nha mãe, ela ta na Achada Santo António", "esperado": {"accao": "actualizar", "campo": "destinatario", "valor": "mãe do cliente", "morada": "Achada Santo António"}}
{"id": "c04", "conversa": "A", "seq": 4, "lingua": "kea", "texto": "N ka kre mas dos, so un", "esperado": {"accao": "actualizar", "produto": "cachupa", "qtd": 1, "nota": "contradição com seq 2; prevalece a mais recente"}}
{"id": "c05", "conversa": "B", "seq": 1, "lingua": "kea", "texto": "bon dia, tem frangu?", "esperado": {"accao": "responder", "produto": "frango-assado", "nota": "pergunta de disponibilidade, não é pedido"}}
{"id": "c06", "conversa": "B", "seq": 2, "lingua": "kea", "texto": "entao da-m un interu y dos pastel", "esperado": {"accao": "criar", "itens": [{"produto": "frango-assado", "variante": "inteiro", "qtd": 1}, {"produto": "pastel", "qtd": 2}]}}
{"id": "c07", "conversa": "B", "seq": 3, "lingua": "kea", "texto": "pastel ka é 2, é 6", "esperado": {"accao": "actualizar", "produto": "pastel", "qtd": 6}}
{"id": "c08", "conversa": "C", "seq": 1, "lingua": "pt", "texto": "Boa tarde, queria 4 cuscuz e um litro de tamarindo", "esperado": {"accao": "criar", "itens": [{"produto": "cuscuz", "qtd": 4}, {"produto": "sumo-tamarindo", "variante": "litro", "qtd": 1}]}}
{"id": "c09", "conversa": "C", "seq": 2, "lingua": "pt", "texto": "e também um bolo de cuscuz", "esperado": {"accao": "pedir_clarificacao", "motivo": "variante_omitida", "produto": "bolo-cuscuz"}}
{"id": "c10", "conversa": "C", "seq": 3, "lingua": "pt", "texto": "inteiro, é para uma festa", "esperado": {"accao": "actualizar", "produto": "bolo-cuscuz", "variante": "inteiro", "qtd": 1}}
{"id": "d11", "conversa": "D", "seq": 1, "lingua": "kea", "texto": "kre 3 risol, 2 pastel y un koka", "esperado": {"accao": "criar", "itens": [{"produto": "rissol", "qtd": 3}, {"produto": "pastel", "qtd": 2}, {"produto": "refrigerante", "variante": "lata", "qtd": 1}]}}
{"id": "d12", "conversa": "D", "seq": 2, "lingua": "kea", "texto": "tira koka, poi agu grandi", "esperado": {"accao": "actualizar", "remover": "refrigerante", "adicionar": {"produto": "agua", "variante": "grande", "qtd": 1}}}
{"id": "e13", "conversa": "E", "seq": 1, "lingua": "kea", "texto": "tem lagosta?", "esperado": {"accao": "sinalizar_duvida", "motivo": "fora_de_catalogo", "termo": "lagosta"}}
{"id": "e14", "conversa": "E", "seq": 2, "lingua": "kea", "texto": "entao aros di marisku, dos", "esperado": {"accao": "criar", "itens": [{"produto": "arroz-marisco", "qtd": 2}]}}
{"id": "f15", "conversa": "F", "seq": 1, "lingua": "kea", "texto": "Oi Bia, nha mudjer fla pa pidi kel fijoada di sabadu, pa 5 pesoa", "esperado": {"accao": "pedir_clarificacao", "motivo": "quantidade_ambigua", "produto": "feijoada", "nota": "'pa 5 pesoa' ≠ 5 doses; perguntar"}}
{"id": "f16", "conversa": "F", "seq": 2, "lingua": "kea", "texto": "5 dosi sim", "esperado": {"accao": "actualizar", "produto": "feijoada", "qtd": 5}}
{"id": "g17", "conversa": "G", "seq": 1, "lingua": "mix", "texto": "Boa tarde. Kre meiu galinha + 4 pon + 2 serveja. Entrega na Palmarejo", "esperado": {"accao": "criar", "itens": [{"produto": "frango-assado", "variante": "meio", "qtd": 1}, {"produto": "pao", "qtd": 4}, {"produto": "cerveja", "qtd": 2}], "morada": "Palmarejo"}}
{"id": "g18", "conversa": "G", "seq": 2, "lingua": "kea", "texto": "kantu ki ta da tudu?", "esperado": {"accao": "responder_total", "nota": "total calculado pelo código: 450+80+300 = 830"}}
{"id": "h19", "conversa": "H", "seq": 1, "lingua": "kea", "texto": "dos kaldu di pexi pa amanha meiu dia", "esperado": {"accao": "criar", "itens": [{"produto": "caldo-peixe", "qtd": 2}], "entrega": "amanhã 12:00"}}
{"id": "h20", "conversa": "H", "seq": 2, "lingua": "kea", "texto": "ah y un keju", "esperado": {"accao": "pedir_clarificacao", "motivo": "variante_omitida", "produto": "queijo-cabra"}}
{"id": "h21", "conversa": "H", "seq": 3, "lingua": "kea", "texto": "meiu ta bom", "esperado": {"accao": "actualizar", "produto": "queijo-cabra", "variante": "meio", "qtd": 1}}
{"id": "i22", "conversa": "I", "seq": 1, "lingua": "kea", "texto": "mi é Dju, kel enkomenda di onti, podi aumenta mas un grogu?", "esperado": {"accao": "sinalizar_duvida", "motivo": "referencia_encomenda_anterior", "nota": "exige identificar encomenda aprovada e reabrir para nova aprovação"}}
{"id": "j23", "conversa": "J", "seq": 1, "lingua": "kea", "texto": "kre kel katxupa rifugadu, 2, y 2 kafé", "esperado": {"accao": "criar", "itens": [{"produto": "cachupa-refogada", "qtd": 2}, {"produto": "cafe", "qtd": 2}]}}
{"id": "j24", "conversa": "J", "seq": 2, "lingua": "kea", "texto": "kafé ka, kre sumu", "esperado": {"accao": "pedir_clarificacao", "motivo": "produto_ambiguo", "nota": "'sumu' pode ser tamarindo ou refrigerante; perguntar", "remover": "cafe"}}
{"id": "k25", "conversa": "K", "seq": 1, "lingua": "pt", "texto": "Olá! Para amanhã: 10 pastéis, 10 rissóis, 1 garrafa de ponche. Obrigada", "esperado": {"accao": "criar", "itens": [{"produto": "pastel", "qtd": 10}, {"produto": "rissol", "qtd": 10}, {"produto": "ponche", "qtd": 1}], "entrega": "amanhã"}}
{"id": "k26", "conversa": "K", "seq": 2, "lingua": "pt", "texto": "Desculpa, afinal são 12 de cada", "esperado": {"accao": "actualizar", "itens": [{"produto": "pastel", "qtd": 12}, {"produto": "rissol", "qtd": 12}]}}
{"id": "l27", "conversa": "L", "seq": 1, "lingua": "kea", "texto": "😂😂 kre kel di senpri", "esperado": {"accao": "sinalizar_duvida", "motivo": "referencia_implicita", "nota": "'o de sempre' sem histórico; perguntar"}}
{"id": "m28", "conversa": "M", "seq": 1, "lingua": "kea", "texto": "un dosi di papaia y 3 agu pikinoti", "esperado": {"accao": "criar", "itens": [{"produto": "doce-papaia", "qtd": 1}, {"produto": "agua", "variante": "pequena", "qtd": 3}]}}
{"id": "n29", "conversa": "N", "seq": 1, "lingua": "kea", "texto": "katxupa grandi 2 pa mi, 1 pikinoti pa nha fidju", "esperado": {"accao": "criar", "itens": [{"produto": "cachupa", "variante": "grande", "qtd": 2}, {"produto": "cachupa", "variante": "pequena", "qtd": 1}]}}
{"id": "n30", "conversa": "N", "seq": 2, "lingua": "kea", "texto": "kansela tudu, dispensa", "esperado": {"accao": "cancelar", "nota": "cancelamento explícito; rascunho vai para estado cancelado"}}
